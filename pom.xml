<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>name.gano</groupId>
    <artifactId>jsattrak</artifactId>
    <version>4.1.19</version>
    <packaging>jar</packaging>

    <name>JSatTrak</name>
    <description>Satellite Tracking Application</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Beanshell -->
        <dependency>
            <groupId>org.beanshell</groupId>
            <artifactId>bsh</artifactId>
            <version>2.0b4-seg</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/Beanshell/bsh-2.0b4_seg.jar</systemPath>
        </dependency>

        <!-- Jama (Matrix Library) -->
        <dependency>
            <groupId>gov.nist.math</groupId>
            <artifactId>jama</artifactId>
            <version>1.0.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/Jama/Jama-1.0.2.jar</systemPath>
        </dependency>

        <!-- Java Media Framework (JMF) -->
        <dependency>
            <groupId>javax.media</groupId>
            <artifactId>jmf</artifactId>
            <version>2.1.1e</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/Java_Media_Framework/jmf.jar</systemPath>
        </dependency>

        <!-- JGoodies Looks -->
        <dependency>
            <groupId>com.jgoodies</groupId>
            <artifactId>looks</artifactId>
            <version>2.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/JGoodies-Looks/looks-2.2.1.jar</systemPath>
        </dependency>

        <!-- JOGL / GlueGen -->
        <dependency>
            <groupId>net.java.dev.gluegen</groupId>
            <artifactId>gluegen-rt</artifactId>
            <version>1.0b06</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/JOGL/gluegen-rt.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jogl</groupId>
            <artifactId>jogl</artifactId>
            <version>1.1.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/JOGL/jogl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jogl</groupId>
            <artifactId>joglutils</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/JOGLUTILS/JOGLUTILS.jar</systemPath>
        </dependency>

        <!-- Netscape / Plugin -->
        <dependency>
            <groupId>netscape</groupId>
            <artifactId>plugin</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/Netscape_JavaScript/plugin.jar</systemPath>
        </dependency>

        <!-- Swing Layout -->
        <dependency>
            <groupId>org.swinglabs</groupId>
            <artifactId>swing-layout</artifactId>
            <version>1.0.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/Swing Layout Extensions/swing-layout-1.0.3.jar</systemPath>
        </dependency>

        <!-- Substance Look and Feel -->
        <dependency>
            <groupId>org.pushingpixels</groupId>
            <artifactId>substance</artifactId>
            <version>7.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/substance/substance-7.2.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.pushingpixels</groupId>
            <artifactId>substance-swingx</artifactId>
            <version>7.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/substance/substance-swingx-7.2.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.pushingpixels</groupId>
            <artifactId>trident</artifactId>
            <version>7.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/substance/trident-7.2.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.pushingpixels</groupId>
            <artifactId>trident-base</artifactId>
            <version>7.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/substance/trident-7.2.1-base.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.pushingpixels</groupId>
            <artifactId>trident-swing</artifactId>
            <version>7.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/substance/trident-7.2.1-swing.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.pushingpixels</groupId>
            <artifactId>laf-plugin</artifactId>
            <version>7.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/substance/laf-plugin-7.2.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.pushingpixels</groupId>
            <artifactId>laf-widget</artifactId>
            <version>7.2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/substance/laf-widget-7.2.1.jar</systemPath>
        </dependency>

        <!-- NASA WorldWind -->
        <dependency>
            <groupId>gov.nasa</groupId>
            <artifactId>worldwind</artifactId>
            <version>0.6.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/worldwind/worldwind.jar</systemPath>
        </dependency>

        <!-- XStream and XPP3 -->
        <dependency>
            <groupId>com.thoughtworks.xstream</groupId>
            <artifactId>xstream</artifactId>
            <version>1.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/xstream/xstream-1.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>xpp3</groupId>
            <artifactId>xpp3_min</artifactId>
            <version>1.1.4c</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/Required_Libraries/xstream/xpp3_min-1.1.4c.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>8</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- JAR packaging with Manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>jsattrak.gui.JSatTrak</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                        <manifestEntries>
                            <SplashScreen-Image>icons/logo/JSatTrakLogo_128.png</SplashScreen-Image>
                            <Class-Path>lib/bsh-2.0b4-seg.jar lib/jama-1.0.2.jar lib/jmf-2.1.1e.jar lib/looks-2.2.1.jar lib/gluegen-rt-1.0b06.jar lib/jogl-1.1.1.jar lib/joglutils-1.0.jar lib/plugin-1.0.jar lib/swing-layout-1.0.3.jar lib/substance-7.2.1.jar lib/substance-swingx-7.2.1.jar lib/trident-7.2.1.jar lib/trident-base-7.2.1.jar lib/trident-swing-7.2.1.jar lib/laf-plugin-7.2.1.jar lib/laf-widget-7.2.1.jar lib/worldwind-0.6.0.jar lib/xstream-1.3.jar lib/xpp3_min-1.1.4c.jar</Class-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Copy dependency JARs to target/lib for distribution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>system</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Exec Plugin to run directly from Maven -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>jsattrak.gui.JSatTrak</mainClass>
                    <systemProperties>
                        <systemProperty>
                            <key>sun.java2d.noddraw</key>
                            <value>true</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
